{
  "configurations": [
    {
      "name": "Zenstar ARM",
      "compilerPath": "/usr/bin/aarch64-linux-gnu-g++",
      "intelliSenseMode": "linux-gcc-arm64",
      "cStandard": "c17",
      "cppStandard": "c++17",
      "includePath": [
        "${workspaceFolder}/**",
        "${workspaceFolder}/app/include",
        "${workspaceFolder}/hal/include",
        "/usr/aarch64-linux-gnu/include",
        "/usr/lib/gcc-cross/aarch64-linux-gnu/14/include"
      ],
      "defines": [
        "LINUX",
        "ARM64"
      ],
      "browse": {
        "path": [
          "${workspaceFolder}/app/include",
          "${workspaceFolder}/hal/include"
        ],
        "limitSymbolsToIncludedHeaders": true
      }
    }
  ],
  "version": 4
}


