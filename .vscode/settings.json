{
  "cmake.generator": "Unix Makefiles",
  "cmake.buildDirectory": "${workspaceFolder}/build",
  "cmake.configureArgs": [
    "-DCMAKE_SYSTEM_NAME=Linux",
    "-DCMAKE_SYSTEM_PROCESSOR=aarch64",
    "-DCMAKE_C_COMPILER=aarch64-linux-gnu-gcc",
    "-DCMAKE_CXX_COMPILER=aarch64-linux-gnu-g++",
    "-DCMAKE_BUILD_TYPE=Debug"
  ],
  "C_Cpp.default.compilerPath": "/usr/bin/aarch64-linux-gnu-g++",
  "C_Cpp.default.intelliSenseMode": "linux-gcc-arm64",
  "C_Cpp.default.includePath": [
    "${workspaceFolder}/**",
    "/usr/aarch64-linux-gnu/include",
    "/usr/lib/gcc-cross/aarch64-linux-gnu/14/include"
  ],
  "C_Cpp.default.defines": [
    "__aarch64__",
    "__ARM_NEON"
  ],
  "C_Cpp.errorSquiggles": "enabled",
  "C_Cpp.clangTidy.enabled": true,
  "C_Cpp.clangTidy.path": "/usr/bin/clang-tidy",
  "files.associations": {
    "assert.h": "c"
  }
}

